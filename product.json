:root { color-scheme: light; --ink: #171717; --muted: #666; --line: #e5e5e5; }
* { box-sizing: border-box; }
body { margin: 0; min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; background: white; color: var(--ink); font: 15px/1.6 Arial, Helvetica, sans-serif; }
a { color: inherit; text-underline-offset: 4px; }
button { font: inherit; color: inherit; cursor: pointer; }
a, button { -webkit-tap-highlight-color: transparent; }
a:focus-visible, button:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
[hidden] { display: none !important; }
.container { width: min(1120px, calc(100% - 64px)); margin-inline: auto; }
.skip { position: absolute; left: 16px; top: -80px; background: white; padding: 12px; z-index: 10; }
.skip:focus { top: 10px; }
header { border-bottom: 1px solid var(--line); }
.navigation { display: flex; flex-wrap: wrap; gap: 10px; padding-block: 24px; }
.navigation a, .button { display: inline-block; border: 1px solid var(--line); border-radius: 5px; padding: 9px 21px; background: white; font-size: 14px; text-decoration: none; }
.navigation a:hover, .button:hover { border-color: #999; }
.navigation a[aria-current="page"] { border-color: var(--ink); font-weight: 600; }
main { flex: 1; padding-block: 55px 72px; }
#home { padding-block: 35px 65px; }
.eyebrow { margin: 0 0 20px; color: var(--muted); font-size: 12px; letter-spacing: .16em; text-transform: uppercase; }
h1 { margin: 0; font-size: clamp(42px, 7vw, 80px); line-height: 1.1; font-weight: 500; letter-spacing: -.045em; overflow-wrap: anywhere; }
.description { max-width: 560px; margin-top: 28px; font-size: 18px; color: var(--muted); white-space: pre-line; }
.home-note { max-width: 550px; margin-top: 35px; color: var(--muted); font-size: 14px; }
.catalog-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
.catalog-heading h1 { font-size: 36px; letter-spacing: -.025em; }
.catalog-heading p { color: var(--muted); font-size: 13px; white-space: nowrap; }
.product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 38px 24px; }
.product-card { min-width: 0; }
.photo { aspect-ratio: 4 / 5; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; overflow: hidden; }
.photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
.photo span { font-size: 12px; color: var(--muted); text-align: center; padding: 8px; }
.photo-controls { display: flex; align-items: center; justify-content: space-between; gap: 4px; margin-top: 8px; }
.photo-controls button { border: 1px solid var(--line); background: white; border-radius: 4px; min-width: 44px; min-height: 44px; }
.photo-controls button:hover { border-color: #999; }
.photo-controls span { font-size: 12px; color: var(--muted); }
.product-card h2 { margin: 15px 0 10px; font-size: 16px; font-weight: 500; overflow-wrap: anywhere; }
.details { margin: 0; font-size: 13px; }
.detail { display: flex; justify-content: space-between; gap: 8px; margin-top: 5px; }
.detail dt { color: var(--muted); }
.detail dd { margin: 0; text-align: right; overflow-wrap: anywhere; min-width: 0; }
.detail.price dd { white-space: nowrap; }
.sizes { display: flex; flex-wrap: wrap; gap: 4px; justify-content: flex-end; }
.size { display: inline-block; padding: 0 5px; border: 1px solid var(--line); border-radius: 3px; font-size: 11px; }
.catalog-back { margin-top: 40px; text-align: center; }
footer { border-top: 1px solid var(--line); padding-block: 34px 22px; color: var(--muted); font-size: 14px; }
.footer-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
footer h2 { margin: 0 0 12px; color: var(--ink); font-size: 13px; font-weight: 600; }
footer p { margin: 0 0 6px; }
.socials { display: flex; flex-wrap: wrap; gap: 8px 18px; }
.copyright { border-top: 1px solid var(--line); margin-top: 28px; padding-top: 18px; font-size: 12px; }
@media (max-width: 700px) {
  .container { width: calc(100% - 32px); }
  .navigation { gap: 7px; padding-block: 16px; }
  .navigation a { padding: 8px 12px; font-size: 13px; }
  main { padding-block: 34px 48px; }
  #home { padding-block: 25px 35px; }
  .description { font-size: 16px; }
  .catalog-heading { gap: 10px; margin-bottom: 22px; }
  .catalog-heading h1 { font-size: 29px; }
  .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 14px; }
  .product-card h2 { font-size: 14px; margin-top: 12px; }
  .details { font-size: 12px; }
  .detail { flex-wrap: wrap; gap: 0 6px; }
  .footer-grid { grid-template-columns: 1fr; gap: 24px; }
}
